(spa) {
	encode

	log
	log_skip /health

	handle /health {
		respond "OK"
	}

	handle /api/* {
		reverse_proxy https://yukiani.com {
			header_up Host yukiani.com
			transport http {
				versions 1.1 2
				keepalive 2m
				dial_timeout 10s
				response_header_timeout 30s
			}
		}
	}

	# 静态资源长期缓存
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA 路由回退到 index.html
	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}

# 国内公开站：静态页面本地提供，API 反代日本站。
www.yukiani.cn {
	root * /srv/client
	import spa
}

yukiani.cn {
	redir https://www.yukiani.cn{uri} 308
}

# 容器健康检查不依赖域名解析、证书签发或日本上游。
http://127.0.0.1 {
	respond /health "OK"
	respond 404
}

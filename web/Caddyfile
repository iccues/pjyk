(spa) {
	encode

	log
	log_skip /health

	handle /health {
		respond "OK"
	}

	handle /api/* {
		reverse_proxy server:8080
	}

	# 静态资源长期缓存
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA 路由回退到 index.html
	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}

# web-client
:80 {
	root * /srv/client
	import spa
}

# web-admin
:81 {
	root * /srv/admin
	import spa
}

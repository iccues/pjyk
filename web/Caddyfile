(spa) {
	encode

	log
	log_skip /health

	handle /health {
		respond "OK"
	}

	handle /api/graphql {
		reverse_proxy pjyk-server:8080
	}

	handle /api/* {
		respond 404
	}

	# 静态资源长期缓存
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA 路由回退到 index.html
	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}

www.yukiani.cn {
	root * /srv/client
	import spa
}

yukiani.cn {
	redir https://www.yukiani.cn{uri} 308
}

# 容器健康检查使用本机 HTTP，不依赖公网证书。
http://127.0.0.1 {
	respond /health "OK"
	respond 404
}
